# Templated by the nginx image's docker-entrypoint.d/20-envsubst-on-templates.sh
# at container start — only ${PORT} is substituted (envsubst is restricted to
# names that exist as real environment variables, so nginx's own $uri/$host
# runtime variables below are left untouched).
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss image/svg+xml;

    # add_header does not merge across nesting levels — a location that sets
    # its own add_header (for Cache-Control, below) silently drops any
    # server-level ones. Repeating these in every location is what actually
    # applies them everywhere.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Container/platform health check target (Dockerfile HEALTHCHECK, Railway).
    location = /health {
        access_log off;
        default_type text/plain;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        return 200 "ok\n";
    }

    # Vite fingerprints these filenames on every change, so they're safe to
    # cache forever — a new build always ships a new URL.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    }

    # SPA fallback: let React Router own every unmatched path.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    }
}
