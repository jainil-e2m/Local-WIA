# Dependencies and build output (both produced fresh inside the image)
node_modules
**/node_modules
dist
dist-ssr

# Version control
.git
.gitignore

# Env files — never bake secrets into an image
.env
.env.*
!.env.example

# Local tooling / caches
*.tsbuildinfo
coverage
.claude
.vscode
.idea
*.local

# Docs (not needed at runtime)
README.md
LICENSE
