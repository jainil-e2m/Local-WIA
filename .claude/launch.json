{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mvp-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8094", "--directory", "knowledge_base/wia-knowledge-base/mvp"],
      "port": 8094
    },
    {
      "name": "kb-api",
      "runtimeExecutable": "knowledge_base/wia-knowledge-base/backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "backend.app:app", "--app-dir", "knowledge_base/wia-knowledge-base",
                      "--host", "127.0.0.1", "--port", "8010"],
      "port": 8010
    },
    {
      "name": "kb-frontend-sample",
      "runtimeExecutable": "node",
      "runtimeArgs": ["knowledge_base/wia-knowledge-base/frontend/node_modules/vite/bin/vite.js", "knowledge_base/wia-knowledge-base/frontend",
                      "--host", "127.0.0.1", "--port", "3002", "--strictPort"],
      "port": 3002
    },
    {
      "name": "kb-frontend-wia",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "knowledge_base/wia-knowledge-base/frontend", "run", "dev:wia"],
      "port": 3001
    }
  ]
}
