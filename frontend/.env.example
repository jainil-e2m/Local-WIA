# Copy to .env.local for local development (never commit real .env files —
# only this example stays in version control).

# NOTE: no audit service URL belongs in this section. Every audit product is
# reached through the server-side BFF configured further down, so no upstream
# URL or bearer token ever enters the browser bundle.

# --- Automation enable flags (one per tile) ---
# Public destination for the landing page's Content Atelier "View Here" link.
# Set to the deployed app URL. Blank/invalid values keep the button disabled.
# Used at build time for the tile and at runtime for the automatic sign-in
# handoff. Keep it set on the Railway service, then redeploy after changing it.
# Do not put credentials here. The server pins the callback to this origin.
VITE_CONTENT_ATELIER_URL=

# Switch an automation between LIVE (its card opens its page and Run Audit is
# clickable) and LOCKED (greyed card, "Coming soon", nothing navigates).
# Accepts true/1/yes/on/enabled/live — or false/0/no/off/disabled/locked.
#
# Leave a flag BLANK to keep whatever `status` is committed in
# src/data/tools.ts — omitting these never changes current behaviour.
#
# These are VITE_ vars, so they are compiled into the browser bundle: changing
# one on Railway needs a REDEPLOY, not just a restart.
VITE_TOOL_OPS_HUB_ENABLED=
VITE_TOOL_TECHNICAL_SEO_ENABLED=
VITE_TOOL_INTERNAL_MEETING_ENABLED=
VITE_TOOL_ROLL_CALL_ENABLED=
VITE_TOOL_MONTHLY_REPORT_PACK_ENABLED=
VITE_TOOL_AI_SEO_ENABLED=
VITE_TOOL_AI_PRESENCE_CHECKER_ENABLED=
VITE_TOOL_ON_PAGE_SEO_ENABLED=
VITE_TOOL_LEAD_MAGNET_ENABLED=

# --- Operations Hub (/ops-hub) — DELIBERATELY NO VARIABLES ---
# Stated here so nobody goes hunting for one. The Ops Hub is a mock end to
# end: its six screens run entirely in the browser off src/data/opsHub.ts,
# there is no /api/ops-hub route, no connector and no persistence. It needs no
# URL, no token and no volume. The only thing gating it in production is the
# session cookie, because it sits behind RequireAuth like every other
# non-public route.
#
# It does carry a library flag (VITE_TOOL_OPS_HUB_ENABLED above), which is a
# different thing: that only decides whether its TILE shows as live in the
# automations library. The route and the hero button are unaffected.
#
# Nothing to set. If a variable ever appears for it, that means it stopped
# being a mock.

# --- Runtime container config (not Vite vars — consumed by the Express
# server in server/, never the client bundle) ---
# Railway injects PORT automatically in production, and docker-compose.yml sets
# PORT in its own `environment:` block (it does not read this file), so PORT
# normally needs no value here.
#
# Leave it commented. For local dev it MUST be 8787 if set at all, because
# vite.config.ts proxies /api to http://localhost:8787 — a stray PORT=8080 makes
# every /api call from the SPA fail with nothing listening.
# PORT=8787

# --- Audit backends-for-frontend (server-only) ---
# The browser calls same-origin /api/technical-seo/*, /api/ai-seo/*,
# /api/ai-presence/* and /api/on-page-seo/* with its session cookie. Express
# forwards each to its HTTPS API and adds that API's bearer token privately. Do
# not rename any of these with a VITE_ prefix.
#
# Each URL must be the service ORIGIN with no path and no trailing slash — the
# proxy forwards an absolute path, which discards any base path.
TECHNICAL_SEO_AUDIT_URL=
TECHNICAL_SEO_API_AUTH_TOKEN=
AI_SEO_AUDIT_URL=
AI_SEO_API_AUTH_TOKEN=
AI_PRESENCE_AUDIT_URL=
AI_PRESENCE_API_AUTH_TOKEN=
ON_PAGE_SEO_AUDIT_URL=
ON_PAGE_SEO_API_AUTH_TOKEN=

# Path prefixes. Technical SEO and AI SEO serve the audit contract at their
# root; AI Presence mounts its routes under its own API_PREFIX (default
# /api/v1), and On-Page SEO versions its whole HTTP surface (/v1).
#
# LEAVE THESE TWO COMMENTED OUT unless the upstream deployment differs. Unlike
# every other variable here, a BLANK value is meaningful — it says "the service
# serves the contract at its root" and overrides the default, which would make
# every proxied call 404. Uncomment only to set a real different prefix, or to
# deliberately choose the empty-string behaviour.
# AI_PRESENCE_AUDIT_BASE_PATH=/api/v1
# ON_PAGE_SEO_AUDIT_BASE_PATH=/v1

# --- Bookmarks store (server-only) ---
# Bookmarks are one shared JSON document (~200 bytes each), not a database.
# Leave blank locally. In production point this at a MOUNTED VOLUME so the file
# survives redeploys — Railway replaces the container filesystem every deploy:
#   BOOKMARKS_FILE=/data/bookmarks.json
# Without it the server still works, it just warns and resets on redeploy.
BOOKMARKS_FILE=

# --- Lead Magnet interim lead store (server-only) ---
# Leads captured by the public Lead Magnet funnel pages, stored as one JSON
# document until the three per-service Lead Magnet backends exist (see
# Lead_Magnet/leadmagnet_central_dashboard_integration.md). Same volume advice
# as BOOKMARKS_FILE:
#   LEADS_FILE=/data/leads.json
LEADS_FILE=

# Browser origins allowed to POST lead captures (comma-separated, exact
# scheme://host[:port]). Defaults to http://localhost:3000 — the funnel app's
# dev server — so local dev needs no value. In production set the funnel
# service's public origin:
#   LEADMAGNET_CAPTURE_ORIGINS=https://wahhadesign.up.railway.app
LEADMAGNET_CAPTURE_ORIGINS=

# --- Auth (all optional; server/index.mjs ships working defaults) ---
# HMAC key for session cookies. REQUIRED when NODE_ENV=production (the server
# refuses to start without it, as it does with AUTH_DISABLED set or no
# AUTH_PASSWORD_HASH; S.C1): a long random value (e.g. `openssl rand -hex 32`)
# as a Railway service variable so sessions survive restarts/redeploys.
SESSION_SECRET=

# Override the seeded (team) account. Generate the hash with:
#   node server/hash-password.mjs "your-new-password"
#
# The committed default is team@weddingindustryads.com. The inherited
# team@wahha.design address is also accepted, with the same password, ONLY
# while AUTH_EMAIL is unset — setting AUTH_EMAIL here drops that alias. Set it
# explicitly in production so the account is named rather than inherited.
AUTH_EMAIL=
AUTH_PASSWORD_HASH=
AUTH_NAME=

# Optional second account for the client / consumer. It is enabled ONLY when
# both CLIENT_EMAIL and CLIENT_PASSWORD_HASH are set (leave them blank to stay
# single-account). Generate the hash the same way:
#   node server/hash-password.mjs "the-client-password"
# CLIENT_NAME defaults to "Client" when omitted.
CLIENT_EMAIL=
CLIENT_PASSWORD_HASH=
CLIENT_NAME=

# Any number of FURTHER logins, numbered USER_1_* .. USER_20_*. Same rule as
# above: the account exists only when both _EMAIL and _PASSWORD_HASH are set.
#   USER_n_NAME  optional, defaults to the email's local part
#   USER_n_ROLE  optional, "team" or "client", defaults to "client"
# Gaps are fine — clearing USER_1_* does not disable USER_2_*. Adding an account
# is variables + redeploy; no code change. Unset slots are simply skipped.
# USER_1_EMAIL=
# USER_1_PASSWORD_HASH=
# USER_1_NAME=
# USER_1_ROLE=
