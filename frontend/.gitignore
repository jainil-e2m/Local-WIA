# Dependencies
node_modules/
server/node_modules/

# Build output
dist/
dist-ssr/
*.local

# Test coverage
coverage/

# Environment — these hold live secrets and must never be committed.
# .env.local currently carries CLICKUP_TEAM_ID, a personal pk_ ClickUp token,
# AUTH_DISABLED and LEADS_DATABASE_URL credentials. .env.example is the file
# that belongs in version control instead.
.env
.env.*
!.env.example

# Runtime data written by the Express BFF (bookmarks store, lead cache)
.data/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code — whole directory. settings.local.json is a per-machine
# permission allowlist, and launch.json points at local ports, so neither
# belongs in a shared repo. Anyone cloning this can regenerate launch.json;
# .env.example and DEPLOY.md are the shared config that matters.
.claude/

# Railway CLI local project link. Written by `railway link` / `railway init`
# and scoped to one machine + one Railway account, so committing it would
# point a teammate's CLI at this checkout's service.
.railway/

# Incremental TypeScript build state. tsconfig currently routes these into
# node_modules/.tmp (already ignored), but `npm run build` runs `tsc -b`, so
# any future change to tsBuildInfoFile would otherwise drop them in-repo.
*.tsbuildinfo

# Vite writes this next to the config whenever it has to transpile
# vite.config.ts before loading it. Transient, but it lands in the repo root.
vite.config.ts.timestamp-*

# ── corpus/ — fetched client data ───────────────────────────────────────
# Only the written notes are committed. The Content Atelier owns its corpus
# now and the fetch scripts are gone, but a local corpus/ may still hold WIA's
# real marketing emails with full bodies and recipient counts, private Slack
# channel history, and downloaded attachments. None of that belongs in a git
# remote.
# INVERTED ON PURPOSE. corpus/ exists to hold client data, so the default is
# "ignore" and the exceptions are the hand-written notes. A blacklist would
# need editing for every new folder (drive/, zoom/, fathom/, instagram/,
# chatgpt/); this way anything fetched is ignored the moment it is created.
corpus/*
!corpus/*.md
!corpus/*.tsv
!corpus/emails/
corpus/emails/*
!corpus/emails/README.md
!corpus/emails/_INDEX.md
!corpus/emails/_TEMPLATE.md

# ── credentials, in any shape ───────────────────────────────────────────
# Nothing of this kind exists in the repo today. These are here so that the
# first time one is downloaded — a Google service-account key for the Drive
# integration is the likely candidate — it is already ignored.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*service-account*.json
*-credentials.json
secrets.json
.secrets

# Browser network captures. A .har of an authenticated session contains
# every bearer token that session sent.
*.har
scripts/.video-deps/
