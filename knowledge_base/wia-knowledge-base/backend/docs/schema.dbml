// WIA Client Knowledge Base: PostgreSQL schema
// Generated from backend/models/db (SQLAlchemy) at migration head. Paste into https://dbdiagram.io

Table account_team_members {
  id uuid [pk]
  business_id uuid [not null]
  person_id uuid [not null]
  role varchar(30) [not null]
  status varchar(20) [not null, default: 'suggested']
  source varchar(30) [not null]
  evidence jsonb [not null]
  started_on date
  ended_on date
  confirmed_by varchar(200)
  confirmed_at timestamptz
  revision integer [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    business_id [name: 'ix_account_team_members_business_id']
    (business_id, role, person_id) [unique, note: 'partial: status <> \'ended\'', name: 'uq_account_team_active']
    business_id [unique, note: 'partial: role = \'owner\' AND status = \'confirmed\'', name: 'uq_account_team_confirmed_owner']
  }

  Note: '''Checks:
- role IN ('ads_google','ads_meta','copy','creative','operations','owner','technical')
- started_on IS NULL OR ended_on IS NULL OR started_on <= ended_on
- status IN ('suggested','confirmed','ended')
- source IN ('clickup_assignments','admin','roster_file')'''
}

Table association_reviews {
  id uuid [pk]
  record_id uuid [not null]
  version_id uuid [not null]
  existing_business_ids jsonb [not null]
  proposed_business_ids jsonb [not null]
  reason varchar(60) [not null]
  state varchar(20) [not null, default: 'pending']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    record_id [name: 'ix_association_reviews_record_id']
    record_id [unique, note: 'partial: state = \'pending\'', name: 'uq_association_review_pending']
  }
}

Table audit_events {
  id uuid [pk]
  actor varchar(200) [not null]
  action varchar(100) [not null]
  target_type varchar(50) [not null]
  target_id varchar(100) [not null]
  details jsonb [not null]
  created_at timestamptz [not null]
}

Table business_aliases {
  id uuid [pk]
  business_id uuid [not null]
  alias varchar(200) [not null]

  indexes {
    (business_id, alias) [unique]
    business_id [name: 'ix_business_aliases_business_id']
  }
}

Table businesses {
  id uuid [pk]
  name varchar(200) [not null]
  slug varchar(100) [not null, unique]
  status varchar(20) [not null, default: 'active']
  status_changed_at timestamptz
  lifecycle_stage varchar(30)
  revision integer [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: '''Checks:
- status IN ('active','inactive')'''
}

Table client_source_decisions {
  id uuid [pk]
  business_id uuid [not null]
  provider varchar(20) [not null]
  state varchar(20) [not null, default: 'not_applicable']
  reason varchar(300) [not null]
  decided_by varchar(200) [not null]
  decided_at timestamptz [not null]

  indexes {
    (business_id, provider) [unique]
    business_id [name: 'ix_client_source_decisions_business_id']
  }

  Note: '''Checks:
- state IN ('not_applicable')'''
}

Table connector_accounts {
  id uuid [pk]
  provider varchar(30) [not null]
  provider_account_id varchar(200) [not null]
  display_identity varchar(320)
  expected_identity varchar(320) [not null]
  credential_ref varchar(100) [not null]
  credential_owner varchar(200)
  granted_scopes jsonb [not null]
  state varchar(20) [not null, default: 'active']
  blocked_reason varchar(200)
  last_verified_at timestamptz
  lease_token uuid
  lease_work_id uuid
  lease_until timestamptz
  next_request_at timestamptz
  heavy_request_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (provider, provider_account_id) [unique]
  }

  Note: '''Checks:
- provider IN ('slack','clickup','gmail','drive','calendar','fathom','zoom','leadlock','ghl_billing')
- state IN ('active','blocked')'''
}

Table contacts {
  id uuid [pk]
  business_id uuid [not null]
  email varchar(320)
  domain varchar(253)
  display_name varchar(200)
  status varchar(20) [not null, default: 'candidate']
  origin varchar(20) [not null, default: 'manual']
  revision integer [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (business_id, domain) [unique]
    (business_id, email) [unique]
    business_id [name: 'ix_contacts_business_id']
  }

  Note: '''Checks:
- (email IS NULL) <> (domain IS NULL)
- status IN ('candidate','approved','rejected')'''
}

Table content_units {
  id uuid [pk]
  version_id uuid [not null]
  ordinal integer [not null]
  unit_kind varchar(40) [not null]
  locator jsonb [not null]
  author_identity_id uuid
  occurred_at timestamptz
  text text [not null]
  text_sha256 varchar(64) [not null]
  is_quoted boolean [not null, default: false]
  provider_generated boolean [not null, default: false]
  domain varchar(30) [not null]
  retention_category varchar(40) [not null, default: 'temporary_originals']
  retention_state varchar(20) [not null, default: 'retained']

  indexes {
    (version_id, ordinal) [unique]
    version_id [name: 'ix_content_units_version']
  }

  Note: '''Checks:
- retention_state IN ('retained','expired')
- domain IN ('registry','actions','communications','meetings','profile','support','programme','leads','health','finance')'''
}

Table coverage_windows {
  id uuid [pk]
  scope_id uuid [not null]
  run_id uuid [not null]
  window_start timestamptz
  window_end timestamptz [not null]
  contract_version varchar(40) [not null]
  counts jsonb [not null]
  gaps jsonb [not null]
  state varchar(20) [not null, default: 'open']

  indexes {
    (scope_id, run_id) [unique]
  }

  Note: '''Checks:
- state IN ('open','complete','partial','failed')'''
}

Table drive_nodes {
  id uuid [pk]
  connector_account_id uuid [not null]
  external_id varchar(300) [not null]
  parents jsonb [not null]
  is_folder boolean [not null, default: false]
  name varchar(500) [not null, default: '']

  indexes {
    (connector_account_id, external_id) [unique]
  }
}

Table mailbox_holders {
  id uuid [pk]
  mailbox_person_id uuid [not null]
  holder_person_id uuid [not null]
  valid_from date
  valid_to date
  note varchar(500)

  indexes {
    mailbox_person_id [name: 'ix_mailbox_holders_mailbox_person_id']
  }

  Note: '''Checks:
- valid_from IS NULL OR valid_to IS NULL OR valid_from <= valid_to'''
}

Table people {
  id uuid [pk]
  name varchar(200) [not null]
  kind varchar(20) [not null]
  business_id uuid
  functions jsonb [not null]
  status varchar(20) [not null, default: 'confirmed']
  merged_into_id uuid
  notes varchar(500)
  revision integer [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: '''Checks:
- status IN ('confirmed','pending')
- merged_into_id IS NULL OR merged_into_id <> id
- kind IN ('client_contact','contractor','former','partner','programme_member','prospect','service_account','shared_mailbox','staff','unknown')'''
}

Table person_addresses {
  id uuid [pk]
  person_id uuid [not null]
  kind varchar(20) [not null]
  value varchar(320) [not null]
  source varchar(30) [not null, default: 'admin']
  created_at timestamptz [not null]

  indexes {
    (kind, value) [unique]
    person_id [name: 'ix_person_addresses_person_id']
  }

  Note: '''Checks:
- source IN ('roster','admin','client_contact')
- kind IN ('clickup_user','display_name','email','fathom_email','slack_user')'''
}

Table provider_identities {
  id uuid [pk]
  connector_account_id uuid [not null]
  external_key varchar(320) [not null]
  display_name varchar(200)
  email varchar(320)
  is_internal boolean
  person_id uuid
  party varchar(20)
  party_business_id uuid
  resolution_basis varchar(30)
  resolved_at timestamptz

  indexes {
    (connector_account_id, external_key) [unique]
  }

  Note: '''Checks:
- party IS NULL OR party IN ('internal','shared_mailbox','client','partner','automated','bot','unknown')
- resolution_basis IS NULL OR resolution_basis IN ('provider_id','email','client_contact','client_domain','partner_rule','automated','display_name','admin')'''
}

Table record_associations {
  id uuid [pk]
  record_id uuid [not null]
  business_id uuid [not null]
  basis varchar(30) [not null]
  status varchar(20) [not null, default: 'associated']
  multi_client boolean [not null, default: false]
  created_at timestamptz [not null]

  indexes {
    (record_id, business_id) [unique]
    business_id [name: 'ix_record_associations_business_id']
    record_id [name: 'ix_record_associations_record_id']
  }

  Note: '''Checks:
- status IN ('associated','unresolved','rejected')
- basis IN ('scope_mapping','verified_contact','series_mapping','manual_review')'''
}

Table record_changes {
  id uuid [pk]
  record_id uuid [not null]
  revision integer [not null]
  version_id uuid
  availability varchar(30) [not null]
  created_at timestamptz [not null]

  indexes {
    (record_id, revision) [unique]
    record_id [name: 'ix_record_changes_record_id']
  }
}

Table scope_memberships {
  id uuid [pk]
  record_id uuid [not null]
  scope_id uuid [not null]
  state varchar(20) [not null, default: 'active']
  seen_run_id uuid

  indexes {
    (record_id, scope_id) [unique]
    record_id [name: 'ix_scope_memberships_record_id']
    scope_id [name: 'ix_scope_memberships_scope_id']
  }
}

Table sender_rules {
  id uuid [pk]
  kind varchar(20) [not null]
  email varchar(320) [unique]
  domain varchar(253) [unique]
  reason varchar(300) [not null]
  created_by varchar(200) [not null]
  created_at timestamptz [not null]

  Note: '''Checks:
- (email IS NULL) <> (domain IS NULL)
- kind IN ('team','partner','blocked')'''
}

Table service_engagements {
  id uuid [pk]
  business_id uuid [not null]
  service varchar(100) [not null]
  status varchar(20) [not null, default: 'active']
  started_on date
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    business_id [name: 'ix_service_engagements_business_id']
  }
}

Table source_records {
  id uuid [pk]
  connector_account_id uuid [not null]
  scope_id uuid
  record_kind varchar(40) [not null]
  external_id varchar(300) [not null]
  availability varchar(30) [not null, default: 'available']
  qualification varchar(20) [not null, default: 'content']
  current_version_id uuid
  source_url text
  occurred_at timestamptz
  first_seen_at timestamptz [not null]
  last_seen_at timestamptz [not null]
  admitted_at timestamptz
  revision integer [not null, default: 0]
  provider_state jsonb [not null]
  parent_external_id varchar(300)
  last_observed_at timestamptz

  indexes {
    (connector_account_id, record_kind, external_id) [unique]
    occurred_at [name: 'ix_source_records_occurred_at']
    parent_external_id [name: 'ix_source_records_parent_external_id']
    scope_id [name: 'ix_source_records_scope_id']
  }

  Note: '''Checks:
- availability IN ('available','deleted_upstream','access_lost','out_of_scope')
- qualification IN ('content','metadata_only')'''
}

Table source_scopes {
  id uuid [pk]
  connector_account_id uuid [not null]
  kind varchar(30) [not null]
  external_id varchar(300) [not null]
  name varchar(500) [not null]
  parent_name varchar(500)
  state varchar(20) [not null, default: 'candidate']
  default_domain varchar(30) [not null]
  business_id uuid
  association_mode varchar(20) [not null]
  suggested_business_id uuid
  suggestion_reason varchar(300)
  discovery_stats jsonb [not null]
  approved_at timestamptz
  approved_by varchar(200)
  last_successful_sync_at timestamptz
  revision integer [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (connector_account_id, kind, external_id) [unique]
    connector_account_id [name: 'ix_source_scopes_connector_account_id']
  }

  Note: '''Checks:
- default_domain IN ('registry','actions','communications','meetings','profile','support','programme','leads','health','finance')
- association_mode IN ('dedicated','per_record')
- state IN ('candidate','approved','excluded','retired')
- association_mode <> 'dedicated' OR state <> 'approved' OR business_id IS NOT NULL'''
}

Table source_versions {
  id uuid [pk]
  record_id uuid [not null]
  version_key varchar(200) [not null]
  content_sha256 varchar(64) [not null]
  provider_updated_at timestamptz
  observed_at timestamptz [not null]
  parser_version varchar(40) [not null]
  content_state varchar(20) [not null]
  coverage_notes jsonb [not null]
  attributes jsonb [not null]
  unit_count integer [not null, default: 0]

  indexes {
    (record_id, version_key) [unique]
    record_id [name: 'ix_source_versions_record_id']
  }

  Note: '''Checks:
- content_state IN ('metadata_only','content','content_pending','unsupported','partial')'''
}

Table sync_cursors {
  id uuid [pk]
  scope_id uuid [not null]
  mode varchar(20) [not null]
  cursor text
  generation integer [not null, default: 1]
  updated_at timestamptz [not null]

  indexes {
    (scope_id, mode) [unique]
  }
}

Table sync_runs {
  id uuid [pk]
  connector_account_id uuid [not null]
  scope_id uuid
  mode varchar(20) [not null]
  window_start timestamptz
  window_end timestamptz [not null]
  state varchar(20) [not null, default: 'running']
  started_at timestamptz [not null]
  finished_at timestamptz
  pages integer [not null, default: 0]
  error_class varchar(30)
  stream_id uuid
  generation integer [not null, default: 1]
  checkpoint jsonb [not null]
  target_external_id varchar(300)

  indexes {
    scope_id [name: 'ix_sync_runs_scope_id']
    stream_id [name: 'ix_sync_runs_stream_id']
    stream_id [unique, note: 'partial: state = \'running\'', name: 'uq_sync_run_active_stream']
  }

  Note: '''Checks:
- mode IN ('discovery','backfill','incremental','reconcile','refresh')
- state IN ('queued','running','succeeded','partial','failed')'''
}

Table sync_streams {
  id uuid [pk]
  connector_account_id uuid [not null]
  stream_key varchar(320) [not null]
  scope_id uuid [not null]
  cursor jsonb [not null]
  generation integer [not null, default: 1]
  enabled boolean [not null, default: false]
  next_sync_at timestamptz [not null]
  next_reconcile_at timestamptz [not null]
  last_incremental_at timestamptz
  last_reconciled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (connector_account_id, stream_key) [unique]
    connector_account_id [name: 'ix_sync_streams_connector_account_id']
  }
}

Table webhook_receipts {
  id uuid [pk]
  connector_account_id uuid [not null]
  delivery_id varchar(200) [not null]
  content_hash varchar(64) [not null]
  received_at timestamptz [not null]
  run_id uuid

  indexes {
    (connector_account_id, delivery_id) [unique]
  }
}

Table work_items {
  id uuid [pk]
  kind varchar(50) [not null]
  lane varchar(20) [not null]
  input_signature varchar(300) [not null]
  payload jsonb [not null]
  state varchar(20) [not null, default: 'pending']
  attempt integer [not null, default: 0]
  next_run_at timestamptz [not null]
  lease_token uuid
  lease_until timestamptz
  last_error_class varchar(30)
  last_error text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (kind, input_signature) [unique]
    (lane, next_run_at) [note: 'partial: state IN (\'pending\',\'retry_wait\')', name: 'ix_work_items_due']
  }

  Note: '''Checks:
- state IN ('pending','claimed','retry_wait','succeeded','blocked','failed','cancelled')'''
}

Ref: account_team_members.business_id > businesses.id
