TableGroup "Registry (clients)" {
  businesses
  business_aliases
  service_engagements
  contacts
  client_source_decisions
  sender_rules
}

TableGroup "People (S3)" {
  people
  person_addresses
  mailbox_holders
  account_team_members
}

TableGroup "Sources and evidence" {
  connector_accounts
  source_scopes
  source_records
  source_versions
  content_units
  provider_identities
  record_associations
}

TableGroup "Sync" {
  sync_streams
  sync_runs
  sync_cursors
  coverage_windows
  scope_memberships
  drive_nodes
  record_changes
  association_reviews
  webhook_receipts
}

TableGroup "Ops" {
  work_items
  audit_events
}
