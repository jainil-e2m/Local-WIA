# Copy to backend/.env (gitignored). Never commit real values. Check the result with: python -m backend.scripts.kb config

# The one switch between the two ways the backend runs.
#   false  local development: intake runs on demand (kb backfill + worker --drain), the sync scheduler stays off,
#          and the unauthenticated local-only API routes are open.
#   true   staging / production (Railway variables, not this file): the sync scheduler is on, local-only routes
#          are closed, and every process refuses to start until the production requirements hold:
#          a non-local DATABASE_URL, KB_SECRET_KEY, OPS_TOKEN, INGEST_WINDOW_DAYS unset, and https OAuth
#          addresses for each OAuth app that is configured.
PRODUCTION_MODE=false
# local | staging | production. Leave empty to follow PRODUCTION_MODE (local / production).
# Use staging for the Railway dry-run project; local is refused with PRODUCTION_MODE=true.
ENVIRONMENT=
DATABASE_URL=postgresql+psycopg://kb:kb@localhost:5440/kb
OPS_TOKEN=

# Unset = full history (required in production). Set e.g. 30 for a bounded local test backfill.
INGEST_WINDOW_DAYS=
# Discovery window (days); longer than the backfill so quiet clients still get contacts.
DISCOVERY_WINDOW_DAYS=365
# JSON list of ClickUp spaces where each folder is one client, e.g. ["Client Space A","Client Space B"]
CLICKUP_CLIENT_SPACES=

# Durable sync (B-05). Empty = follows PRODUCTION_MODE (off locally, on in production).
# Set false in production to pause all provider polling; set true locally only to try the scheduler by hand.
SYNC_SCHEDULER_ENABLED=
SCHEDULER_SWEEP_SECONDS=30
SYNC_INTERVAL_SECONDS=300
RECONCILE_INTERVAL_SECONDS=86400
# JSON map of Fathom connector-account UUID -> webhook signing secret, e.g. {"<account-uuid>":"whsec_..."}
FATHOM_WEBHOOK_SECRETS=

SLACK_BOT_TOKEN=
CLICKUP_TOKEN=
CLICKUP_TEAM_ID=
FATHOM_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ClickUp OAuth app "WIA Knowledge Base" (S1): lets each person connect their own ClickUp account,
# so KB edits appear under their name. Values from ClickUp Settings > ClickUp API Settings.
CLICKUP_OAUTH_CLIENT_ID=
CLICKUP_OAUTH_CLIENT_SECRET=
CLICKUP_OAUTH_REDIRECT_URI=http://localhost:8010/api/v1/clickup/oauth/callback
# Fernet key that encrypts stored per-person tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KB_SECRET_KEY=
# KB frontend address; after connecting ClickUp, people are sent back here (prod: the KB's https address)
KB_APP_URL=http://127.0.0.1:3001

# LeadLock Marketplace app "WIA Client Knowledge Base" (private, Target User: Sub-Account, Agency only).
# Client ID / secret: marketplace.gohighlevel.com > My apps > the app > Manage > Secrets (the secret is shown once).
# App ID: in the app's URL. Company ID: the LeadLock agency's ID; grants for any other agency are refused.
LEADLOCK_APP_CLIENT_ID=
LEADLOCK_APP_CLIENT_SECRET=
LEADLOCK_APP_ID=
LEADLOCK_COMPANY_ID=
# Must equal a Redirect URL saved in the app (Advanced Settings > Auth); prod: https://<kb-api>/api/v1/leadlock/oauth/callback
LEADLOCK_REDIRECT_URI=http://localhost:8010/api/v1/leadlock/oauth/callback
# The webhook URL to save in the app (Advanced Settings > Webhooks) is https://<kb-api>/api/v1/leadlock/webhooks.
# LEADLOCK_WEBHOOK_PUBLIC_KEY defaults to HighLevel's published Ed25519 key; set it only if they rotate it.

# Outbound guard. Default off: nothing is sent. sandbox = only the allow-listed targets below.
# Every request still needs a listed approver to type "yes" at an interactive terminal.
OUTBOUND_MODE=off
OUTBOUND_KILL_SWITCH=false
OUTBOUND_APPROVERS=[]
OUTBOUND_SANDBOX_SLACK_CHANNELS=[]
OUTBOUND_SANDBOX_SLACK_USERS=[]
OUTBOUND_SANDBOX_CLICKUP_LISTS=[]

# Shared team password (until named Google sign-in). Required outside local: every page and team route asks
# for it (HTTP Basic, any user name). Make the value with: python -m backend.scripts.kb password-hash
KB_TEAM_PASSWORD_HASH=
# Set by the production image (the built portfolio served at /). Locally the Vite dev server serves it.
FRONTEND_DIST=

# AI layer (OpenRouter). Off unless AI_MODE=live with a key and a monthly budget above 0.
AI_MODE=off
OPENROUTER_API_KEY=
AI_MONTHLY_BUDGET_USD=0
AI_EMAIL_BATCH_HOURS=24
AI_BRIEF_LEAD_HOURS=36
# Per-skill model override, e.g. {"call_brief": "anthropic/claude-sonnet-5.5"}
AI_MODELS={}
# Internal team meetings whose title matches are read in full for actions, e.g. (?i)monday
INTERNAL_MEETING_TITLE_PATTERN=
