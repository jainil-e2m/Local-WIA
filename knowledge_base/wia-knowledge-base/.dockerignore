# The production image needs backend/ and frontend/ sources only. Never real client data or secrets.
.git
**/node_modules
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
backend/.local
backend/.env
backend/.env.*
!backend/.env.example
backend/roster.yaml
**/*.local.json
**/*.local.html
**/client_secret*.json
**/credentials.json
**/token.json
frontend/dist
frontend/dist-*
frontend/exports
frontend/.qa
mvp
docs
kb_tab_scope
verification
