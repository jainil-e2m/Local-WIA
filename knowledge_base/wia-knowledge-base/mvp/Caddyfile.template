# Railpack's default static-site Caddyfile (railwayapp/railpack core/providers/staticfile/Caddyfile.template),
# picked up from the Root Directory (/mvp) in its place. Changes from the default are marked "WIA".
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	# Security headers
	header {
		# Enable cross-site filter (XSS) and tell browsers to block detected attacks
		X-XSS-Protection "1; mode=block"
		# Prevent some browsers from MIME-sniffing a response away from the declared Content-Type
		X-Content-Type-Options "nosniff"
		# Keep referrer data off of HTTP connections
		Referrer-Policy "strict-origin-when-cross-origin"
		# Enable strict Content Security Policy
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		# Remove Server header
		-Server
		# WIA: real client data, keep it out of search engines
		X-Robots-Tag "noindex, nofollow"
	}

	root * {{.StaticFileRoot}}

	# WIA: the site is real_index.html (the 4 pilot clients' real data). index.html is the sample-data
	# source build_real_index.py builds from; it and the repo notes are never served (hidden files 404).
	rewrite / /real_index.html

	# Handle static files
	file_server {
		hide .git
		hide .env*
		hide index.html README.md readme_changes.md railway.json Caddyfile Caddyfile.template
	}

	# Compression with more formats
	encode {
		gzip
		zstd
	}

	# Try files with HTML extension
	try_files {path} {path}.html

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
