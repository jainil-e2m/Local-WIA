{
  "name": "wia-client-knowledge-base",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3001 --strictPort",
    "dev:wia": "vite --mode wia --host 127.0.0.1 --port 3001 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:live": "tsc --noEmit && vite build --mode portfolio",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 3001 --strictPort",
    "export": "tsc --noEmit && vite build --mode export && node scripts/export-client-portfolio.mjs",
    "export:live": "tsc --noEmit && vite build --mode export-live && node scripts/export-client-portfolio.mjs --live",
    "export:wia": "tsc --noEmit && vite build --mode export-wia && node scripts/export-client-portfolio.mjs --wia"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "lucide-react": "0.546.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "agentation": "^3.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
