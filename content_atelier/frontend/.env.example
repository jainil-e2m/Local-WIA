# Runtime server variable. Railway: use the deployed Command Center origin.
# Must be scheme://host[:port], with no path, credentials or query string.
# Read by Node (or Vite's local proxy), never built into the browser bundle.
COMMAND_CENTER_AUTH_ORIGIN=http://localhost:8787

# Only needed when AUTH_ORIGIN uses Railway private networking: the browser
# must redirect to the public HTTPS Command Center origin for automatic login.
# If AUTH_ORIGIN is already public HTTPS, leave this unset.
# COMMAND_CENTER_PUBLIC_ORIGIN=https://your-command-center.up.railway.app

# Local Vite sign-in destination only. Production uses its own /login page,
# forwarding credentials to Command Center and issuing a host-only session.
VITE_COMMAND_CENTER_URL=http://localhost:5173

# Railway injects PORT. For a local production-server test, use 8080.
# PORT=8080
# NODE_ENV=production

# Python backend service (weekly storage, briefs, packs, calendar, intake).
# Server-side only; the secret must equal the backend's ATELIER_API_SECRET.
# Required by the real app (the default build). Only the demo build
# (VITE_ATELIER_MODE=mock) runs without it; backend routes then return 503.
# ATELIER_BACKEND_ORIGIN=http://localhost:8000
# ATELIER_API_SECRET=

# Build-time choice of app: unset or backend builds the real app; only an
# explicit mock builds the saved demo. Never put a secret in a VITE_ variable.
# VITE_ATELIER_MODE=backend

# No model key or database is needed in this app; the demo build needs none at all.
# Live ingestion/model keys belong on the separate Python backend service.
