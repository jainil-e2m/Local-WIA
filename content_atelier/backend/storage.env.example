# Local isolated database only. Production uses private service credentials.
#
# Secrets, paths, the allow-lists and the safety catches (ATELIER_ALLOW_*, ATELIER_SYNTHETIC_DATABASE,
# ATELIER_ALLOW_EMBEDDING_CONTRACT_CHANGE) are environment-only. The briefs, packs, calendar and context flags, the
# brief and pack models, the brief limits and the other ATELIER_* behavioural variables below are settings (plan 0.B8,
# DEPLOYMENT.md "Settings"): each value shown is the code default, a settings row overrides it without a deploy
# (python -m backend_pipeline.storage_cli settings set <key> <value>), and a test fails when this file and the code
# defaults differ. ATELIER_BRIEF_SCHEMA (v1 or v2) selects the brief contract; it is not set here, so v1 applies.
ATELIER_DATABASE_URL=postgresql://atelier:atelier_local_only@127.0.0.1:15432/atelier
# The queue transport of the local stack (backend/compose.yml publishes Redis on this port). Postgres holds every job.
ATELIER_REDIS_URL=redis://127.0.0.1:16379/0
ATELIER_ALLOW_GENERATION=false
ATELIER_ALLOW_ENCODING=false
ATELIER_ALLOW_REFINEMENT=false
ATELIER_BRIEFS_ENABLED=false
ATELIER_ALLOW_BRIEF_GENERATION=false
ATELIER_ALLOW_BRIEF_WEB=false
# Closed by default. Comma-separated Command Center account emails, as the Node server
# resolves them from the session (R37). Approvers decide Gate 1 and Gate 2 and retry briefs;
# editors may edit, rescore and reassess. Whitney and the reviewers she names (R50).
# These are the legacy lists: a person with a row in the users table has that row's role instead
# (`storage_cli users seed` copies these lists into it; see DEPLOYMENT.md, "Users and roles").
ATELIER_BRIEF_APPROVERS=
ATELIER_BRIEF_EDITORS=
# Reviewed JSON bundle: status, approved_by, voice, strategy, cta_rules, exemplars.
# Required when ATELIER_BRIEFS_ENABLED=true with the v1 brief contract: the API and worker refuse to
# start without it. v2 briefs (ATELIER_BRIEF_SCHEMA=v2) read the knowledge base instead (E.B11 f).
ATELIER_BRAND_BUNDLE_PATH=
# Brief writer and repair; plan, grade and review. Replay may leave them blank (the angle
# model is used for request fingerprints); a live brief refuses to run without both (S.B8).
ATELIER_BRIEF_MODEL=openai/gpt-6.1-sol
ATELIER_BRIEF_REVIEW_MODEL=anthropic/claude-sonnet-5.5
ATELIER_BRIEF_MAX_CHARACTERS=120000
# Remains unset until an authoritative comparison policy is explicitly selected.
ATELIER_ANGLE_APPROVAL_CUTOFF=
ATELIER_SYNTHETIC_DATABASE=false
# The one embedding contract; must match the archive (see backend/.env.example).
# The editorial worker reads these through this env file.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
CONTENT_ATELIER_EMBEDDING_DIMENSIONS=1536
# Generate a random shared secret, save in backend/.env.storage.local and the BFF
# environment. Never put it in VITE_* variables or browser storage.
ATELIER_API_SECRET=
# Backend listens on loopback for local use; the BFF alone calls its SQL routes.
ATELIER_BACKEND_ORIGIN=http://127.0.0.1:18081
# Existing Command Center configuration is still required by the BFF.
# Real production and shared calendar. Reads/scheduling never enable paid generation.
ATELIER_PACKS_ENABLED=false
ATELIER_ALLOW_PACK_GENERATION=false
ATELIER_PACK_WRITER_MODEL=
ATELIER_PACK_REVIEW_MODEL=
ATELIER_PACK_EDITORS=
ATELIER_PACK_APPROVERS=
ATELIER_CALENDAR_ENABLED=false
ATELIER_CALENDAR_TIMEZONE=Asia/Kolkata
ATELIER_CALENDAR_SCHEDULERS=
# Phase L context system (DEPLOYMENT.md). The screens stay hidden until the flag is on.
ATELIER_CONTEXT_ENABLED=false
# Whitney: identity changes (rules, exemplars, voice). Blank: any brief approver.
ATELIER_IDENTITY_APPROVERS=
# WIA's own reviewers (emails or names); other people's gate decisions get proxy labels (gate_delegated).
ATELIER_WIA_REVIEWERS=
ATELIER_CONTEXT_EXEMPLARS_K=3
ATELIER_CONTEXT_NIGHTLY_HOUR=3
ATELIER_CONTEXT_MINING_WEEKDAY=0
ATELIER_CONTEXT_MINING_LIVE=false
