# Copy to backend/.env locally. Never commit the real .env file.
# Process variables take precedence, then backend/.env, then the existing
# content_atelier/.env (backward-compatible fallback; no secret move required).
#
# Secrets, endpoints, paths and the safety catches (CONTENT_ATELIER_LIVE, CONTENT_ATELIER_EMBEDDINGS_ENABLED) are
# environment-only. Every other variable below is a BEHAVIOURAL SETTING (plan 0.B8, DEPLOYMENT.md "Settings"): the value
# written here is the code default, and a settings row in the database (python -m backend_pipeline.storage_cli settings
# set <key> <value>) overrides it without a deploy. A variable that differs from the default still applies until a row
# exists; `settings import-env --actor <you>` records the deployment's values as rows. A test fails when a value
# below differs from the code default, so this file always shows what a fresh deployment does.
CONTENT_ATELIER_LIVE=false
# Blank uses the code defaults: backend/zoom_backfill_meetings and testing/.data in this repository.
CONTENT_ATELIER_TRANSCRIPT_ROOT=
CONTENT_ATELIER_DATA_ROOT=

# Shared OpenRouter key for both LLM stages. Luna requires funded credits.
# Leave credentials blank until
# inserting real keys locally; never commit the populated .env file.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Optional per-stage overrides; blank values use OPENROUTER_API_KEY.
OPENROUTER_MOMENTS_KEY=
OPENROUTER_ANGLES_KEY=
OPENROUTER_MOMENTS_MODEL=openai/gpt-6-luna
OPENROUTER_ANGLES_MODEL=openai/gpt-6-luna
# Angle generation only; blank uses OPENROUTER_ANGLES_MODEL. Use openai/gpt-6.1-sol with the strategist profile.
OPENROUTER_ANGLE_GENERATION_MODEL=

# Angle prompt profile (setting prompts.profile.strategist). Default: 2026-10-19.reel-editorial.v2 (v1 is replay only). Opt-in:
# 2026-10-18.wia-strategist.v3 to .v5, which need the WIA knowledge base folder (see backend/docs/Angle-Prompt-Profiles.md).
CONTENT_ATELIER_ANGLE_PROMPT_PROFILE=2026-10-19.reel-editorial.v2
# Development override, environment only (it beats any setting): a file knowledge base to load. Blank uses
# backend/knowledge_base/, which is committed (private repository, decision of 18 October 2026). Pin a compiled
# version with the setting knowledge_base.version instead.
CONTENT_ATELIER_KNOWLEDGE_BASE_DIR=

# The one embedding contract (also the code default, backend_pipeline/config.py).
# The research archive was encoded with exactly these three values; the API and
# workers refuse to start when they differ from the archive's recorded contract.
# Change them only to re-encode the archive deliberately.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
CONTENT_ATELIER_EMBEDDING_DIMENSIONS=1536

# These remain configurable while calibrating the first weeks.
CONTENT_ATELIER_SIMILARITY_THRESHOLD=0.78
CONTENT_ATELIER_CLOSE_THRESHOLD=0.90
CONTENT_ATELIER_VISIBLE_THRESHOLD=70

# Local input-size checks are on by default (setting models.input_limits_enabled); set
# CONTENT_ATELIER_LLM_INPUT_LIMITS_ENABLED=false only for an explicitly uncapped calibration run.
# Provider context/output limits and account limits always remain external constraints.
# No automatic batching or truncation is permitted.
# Counts the week's material, not the trusted system prefix (prompt and knowledge base), as for briefs.
CONTENT_ATELIER_MAX_LLM_REQUEST_CHARACTERS=120000

# Embeddings and vector ranking stay disconnected until the user approves.
CONTENT_ATELIER_EMBEDDINGS_ENABLED=false
# Whole week in one Call 1 (the code default; legacy_flat is the old file pipeline's format).
CONTENT_ATELIER_LLM_PAYLOAD_FORMAT=compact_weekly
# Blank omits max_tokens/max_completion_tokens entirely; no local output cap.
# This is provider-default capacity, NOT infinite output. Incomplete output is rejected.
CONTENT_ATELIER_LLM_COMPLETION_TOKENS=
CONTENT_ATELIER_LLM_INPUT_LIMITS_ENABLED=true
CONTENT_ATELIER_LLM_REASONING_EFFORT=high
# json_schema everywhere (R16). The Luna/Apodex comparison runs set json_object for themselves; the full schema is
# also supplied in the system prompt and strictly validated locally.
CONTENT_ATELIER_LLM_RESPONSE_FORMAT=json_schema
CONTENT_ATELIER_REQUEST_TIMEOUT_SECONDS=900

# Optional outbound schedule notices, on the scheduler only. Reuse the existing bot.
# Configure channels/URL here OR apply deploy/slack-schedule-notifications.settings.json
# (the settings table wins). Empty token means no Slack calls; intake token is unrelated.
ATELIER_SLACK_BOT_TOKEN=
ATELIER_SLACK_EMAIL_CHANNEL_ID=
ATELIER_SLACK_SOCIAL_CHANNEL_ID=
ATELIER_PUBLIC_APP_URL=
