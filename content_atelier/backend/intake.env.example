# Copy to .env.intake.local (ignored). Do not enable connectors until the bot/key are ready.
# Docker Compose passes this file to the container; a process started without Compose reads it through the same
# single environment reader as backend/.env (settings_store.load_env_files). The Slack workspace, channels and the
# audio model are settings (0.B8); the tokens, keys and ATELIER_ALLOW_INTAKE_ENCODING stay in the environment.
ATELIER_API_SECRET=
ATELIER_INTAKE_ADMINS=
ATELIER_SLACK_INTAKE_TOKEN=
# The Fathom key. When this is unset the code reads FATHOM_API_KEY (the name backend/.env uses) instead.
ATELIER_FATHOM_API_KEY=
ATELIER_SLACK_WORKSPACE=T03P5A3L1DK
ATELIER_SLACK_CHANNELS=C082DURRJ2U,C09LQ656BPU,C091CPQD8L9
# Independent of angle/brief generation. Enable to index new live source text.
ATELIER_ALLOW_INTAKE_ENCODING=false
# The one embedding contract; must match the archive (see backend/.env.example).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
OPENAI_EMBEDDING_MODEL=openai/text-embedding-3-small
CONTENT_ATELIER_EMBEDDING_DIMENSIONS=1536
ATELIER_INTAKE_AUDIO_MODEL=small.en
