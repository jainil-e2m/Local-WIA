":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"It's their page.","timestamp":"00:05:50"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"Yeah.","timestamp":"00:05:57"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"And he doesn't really have any...","timestamp":"00:05:57"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"Changes for dose.","timestamp":"00:06:00"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"I mean, doesn't look like anything direct.","timestamp":"00:06:01"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"He's just kind of talking about it.","timestamp":"00:06:02"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"He's like, oh, like there's been no account changes.","timestamp":"00:06:04"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"Still goes to the site.","timestamp":"00:06:07"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"The keyword Hill Country wedding venue has 34 clicks on conversion before it had six.","timestamp":"00:06:09"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"Just as to like check keyword search terms.","timestamp":"00:06:15"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"I'll definitely look and see the accounts today.","timestamp":"00:06:17"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"Just like in my own time, just kind of check and I can update on the weekly meeting, anything I find.","timestamp":"00:06:19"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"But it doesn't look like he has any like tangible things.","timestamp":"00:06:25"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"Got it.","timestamp":"00:06:30"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"Yeah.","timestamp":"00:06:30"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"And I mean, kind of the fact that it's happening for both of them could just be that like things are trending that way in general, I guess.","timestamp":"00:06:30"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"Like they're, they're both in Texas, like not super close to one another, but somewhat similar areas, I guess you could say.","timestamp":"00:06:40"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"Like Weinberg is more outside of, I guess, closer to Houston, whereas.","timestamp":"00:06:52"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"Dos Palomas is closer to San Antonio.","timestamp":"00:07:00"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"Yeah.","timestamp":"00:07:06"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"I mean, it's both clients.","timestamp":"00:07:09"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"It's not like they're like raising concerns on their end at this point about lead volume or anything like that.","timestamp":"00:07:11"