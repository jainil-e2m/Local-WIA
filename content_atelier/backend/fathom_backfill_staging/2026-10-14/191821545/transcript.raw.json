_invitee_email":null},"text":"Like she was fine all weekend.","timestamp":"00:04:46"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"But I'm like, okay, I guess that's what kind of week it's going to be.","timestamp":"00:04:47"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"So yeah, I wasn't surprised.","timestamp":"00:04:51"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"Yeah.","timestamp":"00:04:55"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"Okay.","timestamp":"00:04:57"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"So for","timestamp":"00:04:58"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"Google Ads stuff.","timestamp":"00:05:00"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"was kind of catching up on some of the stuff from Victor.","timestamp":"00:05:01"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"And so everything's good with our access for Pecan Springs, it sounds like.","timestamp":"00:05:06"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"We can see everything in there.","timestamp":"00:05:09"},{"speaker":{"display_name":"Whitney Hodges","matched_calendar_invitee_email":null},"text":"Tina just wasn't seeing it for some reason.","timestamp":"00:05:11"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"Is that right?","timestamp":"00:05:14"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":"carmen@weddingindustryads.com"},"text":"Yeah, I just like sent her the directions for it.","timestamp":"00:05:15"},{"speaker":{"disp