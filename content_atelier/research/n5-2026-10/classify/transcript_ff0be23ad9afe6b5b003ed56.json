   "passage_id": "fathom:190540576:span:223",
   "ordinal": 223,
   "speaker": "rose",
   "speaker_role": "prospect",
   "start_ms": 1020000,
   "text": "rose: Receive an email from me that sets up our next steps, including a no pressure call."
  },
