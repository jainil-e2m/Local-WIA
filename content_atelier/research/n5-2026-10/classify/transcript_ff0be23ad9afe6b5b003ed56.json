   "passage_id": "fathom:190540576:span:219",
   "ordinal": 219,
   "speaker": "Whitney Hodges",
   "speaker_role": "staff",
   "start_ms": 1002000,
   "text": "Whitney Hodges: What, so with what you have kind of set up in Dubsado currently and what your process is like, I guess, just kind of walk me through it, right?"
  },
