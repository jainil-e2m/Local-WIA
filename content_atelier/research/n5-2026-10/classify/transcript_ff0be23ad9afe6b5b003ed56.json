   "ordinal": 25,
   "speaker": "Whitney Hodges",
   "speaker_role": "staff",
   "start_ms": 49000,
   "text": "Whitney Hodges: So I'm Whitney."
  },
  {
   "passage_id": "fathom:190540576:span:26",
   "ordinal": 26,
   "speaker": "Whitney Hodges",
   "speaker_role": "staff",
   "start_ms": 50000,
   "text": "Whitney Hodges: I'm one of the co-founders and co-owners of wedding industry ads."
