   "passage_id": "fathom:190540576:span:221",
   "ordinal": 221,
   "speaker": "Whitney Hodges",
   "speaker_role": "staff",
   "start_ms": 1014000,
   "text": "Whitney Hodges: From there, I usually like send a text saying, I've received your inquiry."
  },
