  {
   "passage_id": "fathom:190540576:span:29",
   "ordinal": 29,
   "speaker": "rose",
   "speaker_role": "prospect",
   "start_ms": 59000,
   "text": "rose: Pretty good pulse on everything that's going on with our clients."
