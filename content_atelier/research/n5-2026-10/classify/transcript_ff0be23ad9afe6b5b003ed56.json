   "passage_id": "fathom:190540576:span:220",
   "ordinal": 220,
   "speaker": "Whitney Hodges",
   "speaker_role": "staff",
   "start_ms": 1010000,
   "text": "Whitney Hodges: Like if somebody were to inquire with you, what then happens from there?"
  },
