   "passage_id": "fathom:190540576:span:218",
   "ordinal": 218,
   "speaker": "Whitney Hodges",
   "speaker_role": "staff",
   "start_ms": 991000,
   "text": "Whitney Hodges: Like when you are dealing with a lower volume of leads, it's definitely easier to manage them, to, you know, follow up with them, all of that."
  },
