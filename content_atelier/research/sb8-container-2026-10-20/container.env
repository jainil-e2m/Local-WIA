# S.B8: a container from the documented variables (DEPLOYMENT.md, "Editorial API and worker"); no key here.
ATELIER_ARTIFACT_ROOT=/artifacts
ATELIER_ARTIFACT_STORE=local
ATELIER_BRIEF_APPROVERS=kenil.shah@e2m.solutions
ATELIER_BRIEF_EDITORS=kenil.shah@e2m.solutions
ATELIER_BRIEFS_ENABLED=true
ATELIER_BRIEF_MODEL=openai/gpt-6.1-sol
ATELIER_BRIEF_REVIEW_MODEL=anthropic/claude-sonnet-5.5
