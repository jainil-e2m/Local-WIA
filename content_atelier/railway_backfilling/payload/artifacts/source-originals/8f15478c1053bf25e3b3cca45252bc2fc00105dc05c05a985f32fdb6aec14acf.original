:45"},{"speaker":{"display_name":"Jacqueline Hood","matched_calendar_invitee_email":null},"text":"Click the button.","timestamp":"00:10:46"},{"speaker":{"display_name":"Jacqueline Hood","matched_calendar_invitee_email":null},"text":"Okay, so this ad here.","timestamp":"00:10:48"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":null},"text":"Mm-hmm.","timestamp":"00:10:50"},{"speaker":{"display_name":"Jacqueline Hood","matched_calendar_invitee_email":null},"text":"Oh my gosh.","timestamp":"00:10:52"},{"speaker":{"display_name":"Jacqueline Hood","matched_calendar_invitee_email":null},"text":"I don't know if it's leggy on my end, or what's going on here.","timestamp":"00:10:53"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":null},"text":"But this ad here.","timestamp":"00:10:56"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":null},"text":"Mm-hmm.","timestamp":"00:10:58"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":null},"text":"Do you want to edit it or no?","timestamp":"00:11:00"},{"speaker":{"display_name":"Jacqueline Hood","matched_calendar_invitee_email":null},"text":"I'll close that one.","timestamp":"00:11:05"},{"speaker":{"display_name":"Jacqueline Hood","matched_calendar_invitee_email":null},"text":"So there's two ways to do it.","timestamp":"00:11:09"},{"speaker":{"display_name":"Jacqueline Hood","matched_calendar_invitee_email":null},"text":"So you can go preview and then pull it and then click Facebook post with comments and you could pull the post ID.","timestamp":"00:11:11"},{"speaker":{"display_name":"Carmen Cruickshank","matched_calendar_invitee_email":null},"text":"From up here?","timestamp":"00:11:26"},{"speaker":{"display_name":"Jacqueline Hood","matched_calendar_invitee_email":null},"text":"Yeah, I can't see the bar, but yeah, it's just like numbers at the end.","timestamp":"00:11:27"},{"speaker":{"display_name":